<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- ======================================== -->
    <!-- SITE TABLE -->
    <!-- ======================================== -->
    <changeSet id="1-create-site" author="greg">
        <createTable tableName="site">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>

            <column name="status_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>

            <column name="last_error" type="TEXT"/>

            <column name="url" type="VARCHAR(255)">
                <constraints
                        nullable="false"
                        unique="true"
                        uniqueConstraintName="uk_site_url"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="site"/>
        </rollback>
    </changeSet>


    <!-- ======================================== -->
    <!-- PAGE TABLE -->
    <!-- ======================================== -->
    <changeSet id="2-create-page" author="greg">
        <createTable tableName="page">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="site_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="path" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="code" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="content" type="MEDIUMTEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="page"
                baseColumnNames="site_id"
                referencedTableName="site"
                referencedColumnNames="id"
                constraintName="fk_page_site"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="page"
                columnNames="site_id, path"
                constraintName="uk_page_site_path"/>
    </changeSet>


    <!-- ======================================== -->
    <!-- LEMMA TABLE -->
    <!-- ======================================== -->
    <changeSet id="3-create-lemma" author="greg">
        <createTable tableName="lemma">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="site_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="lemma" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="frequency" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="lemma"
                baseColumnNames="site_id"
                referencedTableName="site"
                referencedColumnNames="id"
                constraintName="fk_lemma_site"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="lemma"
                columnNames="site_id, lemma"
                constraintName="uk_lemma_site_value"/>


    </changeSet>


    <!-- ======================================== -->
    <!-- PAGE_LEMMA TABLE -->
    <!-- ======================================== -->
    <changeSet id="4-create-page-lemma" author="greg">
        <createTable tableName="page_lemma">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="page_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="lemma_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="rank_value" type="FLOAT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="page_lemma"
                baseColumnNames="page_id"
                referencedTableName="page"
                referencedColumnNames="id"
                constraintName="fk_pagelemma_page"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="page_lemma"
                baseColumnNames="lemma_id"
                referencedTableName="lemma"
                referencedColumnNames="id"
                constraintName="fk_pagelemma_lemma"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="page_lemma"
                columnNames="page_id, lemma_id"
                constraintName="uk_pagelemma_page_lemma"/>

        <createIndex tableName="page_lemma" indexName="idx_pagelemma_page">
            <column name="page_id"/>
        </createIndex>

        <createIndex tableName="page_lemma" indexName="idx_pagelemma_lemma">
            <column name="lemma_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>